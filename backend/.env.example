# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (PostgreSQL) ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=clinic_db

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d