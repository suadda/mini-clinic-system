              ],
              "path": [
                "patients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nik\": \"{{nik}}\",\n  \"nama\": \"Budi Santoso\",\n  \"jenis_kelamin\": \"L\",\n  \"tanggal_lahir\": \"1990-05-17\",\n  \"no_telepon\": \"081234567890\",\n  \"alamat\": \"Jl. Merdeka No. 10, Bandung\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Tambah pasien baru. NIK acak dibuat di pre-request script. Menyimpan {{patient_id}}."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Buat NIK 16 digit acak agar collection bisa dijalankan berulang tanpa bentrok",
                  "const nik = Array.from({length:16}, () => Math.floor(Math.random()*10)).join(\"\");",
                  "pm.collectionVariables.set(\"nik\", nik);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status code 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"success bernilai true\", () => pm.expect(json.success).to.be.true);",
                  "pm.test(\"Ada properti data\", () => pm.expect(json).to.have.property(\"data\"));",
                  "",
                  "pm.test(\"No. rekam medis dibuat otomatis\", () => pm.expect(json.data).to.have.property(\"no_rekam_medis\"));",
                  "if (json.data && json.data.id) pm.collectionVariables.set(\"patient_id\", json.data.id);"
                ]
              }
            }
          ]
        },
